# Application Ports & Environment
NODE_ENV=development
PORT=3001
WEB_PORT=3000

# API & Web URL
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_dummy_key_0000000000000000000000
SUPABASE_SECRET_KEY=sb_secret_dummy_key_0000000000000000000000
SUPABASE_JWKS_URL=https://[project-ref].supabase.co/auth/v1/.well-known/jwks.json

SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_payload
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key_payload

# Redis (Upstash Redis)
REDIS_URL="rediss://default:dummy_redis_password@dummy-redis-instance.upstash.io:6379"
REDIS_PORT=6379
UPSTASH_REDIS_REST_URL="https://dummy-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="dummy_upstash_redis_rest_token"

# Queue (Upstash QStash)
QSTASH_URL="https://qstash-us-east-1.upstash.io"
QSTASH_TOKEN="dummy_qstash_token"
QSTASH_CURRENT_SIGNING_KEY="sig_dummy_current_signing_key"
QSTASH_NEXT_SIGNING_KEY="sig_dummy_next_signing_key"

# Primary Region
QSTASH_REGION="US_EAST_1"

# EU Central 1
EU_CENTRAL_1_QSTASH_URL="https://qstash-eu-central-1.upstash.io"
EU_CENTRAL_1_QSTASH_TOKEN="dummy_eu_central_1_qstash_token"
EU_CENTRAL_1_QSTASH_CURRENT_SIGNING_KEY="sig_dummy_eu_signing_key"
EU_CENTRAL_1_QSTASH_NEXT_SIGNING_KEY="sig_dummy_eu_next_signing_key"

# US East 1
US_EAST_1_QSTASH_URL="https://qstash-us-east-1.upstash.io"
US_EAST_1_QSTASH_TOKEN="dummy_us_east_1_qstash_token"
US_EAST_1_QSTASH_CURRENT_SIGNING_KEY="sig_dummy_us_signing_key"
US_EAST_1_QSTASH_NEXT_SIGNING_KEY="sig_dummy_us_next_signing_key"

# Email (Resend)
RESEND_API_KEY=re_dummy_resend_api_key

# SMS & Authentication (MSG91)
MSG91_AUTH_KEY=dummy-msg91-key
MSG91_SENDER_ID=INDIAN

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Monitoring (Sentry)
SENTRY_DSN=https://dummy@o0.ingest.sentry.io/0
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_payload

GOOGLE_CALLBACK_URL=https://[project-ref].supabase.co/auth/v1/callback

# Razorpay Payment Gateway (WAL-03)
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=dummy_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=dummy_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_dummy_key_id

# Feature Flags (PRN-06: P2/P3 Scope Control)
ENABLE_P2_PAYMENTS=true
ENABLE_P2_WALLET_RECHARGE=true
ENABLE_P2_PLACEMENT_PIPELINE=true
ENABLE_P2_FEATURED_PROMOTIONS=true
