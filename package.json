{
  "name": "indian-job-portal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --parallel --recursive run dev",
    "lint": "pnpm --recursive run lint",
    "test": "vitest run",
    "audit:migrations": "vitest run apps/worker/test/audit-migrations.spec.ts",
    "sync:migrations": "node scripts/sync-migrations.js",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@sentry/node": "^8.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@upstash/qstash": "^2.7.20",
    "csv-parse": "^5.5.6",
    "eslint": "^9.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.3.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<2.4.8": ">=2.4.8",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9",
      "tinypool@<2.1.2": ">=2.1.2"
    }
  }
}
