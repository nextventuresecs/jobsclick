{
  "name": "indian-job-portal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --parallel --recursive run dev",
    "lint": "pnpm --recursive run lint",
    "test": "vitest run",
    "test:db": "vitest run local.test.ts --passWithNoTests --fileParallelism=false",
    "audit:migrations": "vitest run apps/worker/test/audit-migrations.spec.ts",
    "test:attack:module4": "node --experimental-strip-types scripts/attack/module4.ts",
    "ci:check-migrations": "node scripts/ci/check-migrations-single-tree.js",
    "db:bootstrap:staging": "node --experimental-strip-types scripts/bootstrap-staging-db.ts",
    "db:seed:staging": "node --experimental-strip-types scripts/seed-staging.ts",
    "db:bootstrap:drill": "node --experimental-strip-types scripts/drill-fresh-database.ts",
    "db:catalog:check": "node --experimental-strip-types scripts/db-catalog-check.ts",
    "db:security:drill": "node --experimental-strip-types scripts/db-security-drill.ts",
    "db:smoke:postgrest": "node --experimental-strip-types scripts/smoke-postgrest.ts",
    "db:generate-types": "node scripts/generate-types.js",
    "typecheck": "pnpm --filter @indian-job-portal/database --filter @indian-job-portal/validation run build && pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@sentry/node": "^11.19.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@upstash/qstash": "^2.13.0",
    "csv-parse": "^7.0.3",
    "eslint": "^10.15.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<2.4.8": ">=2.4.8",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9",
      "tinypool@<2.1.2": ">=2.1.2"
    }
  }
}
